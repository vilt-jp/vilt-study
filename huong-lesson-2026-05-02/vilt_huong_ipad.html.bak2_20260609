<link rel="stylesheet" href="../assets/common.css">
<style>
.intro{background:#fce4ec;border:1px solid #f48fb1;border-radius:10px;padding:12px;margin-bottom:14px;font-size:12px;color:#ad1457;line-height:1.7}
.mode-sel{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}
.mode-sel button{padding:18px 10px;background:#fff;border:2px solid #e0e0e0;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:90px}
.mode-sel button:active{transform:scale(.97)}
.mode-sel button .ic{font-size:24px;margin-bottom:6px}
.mode-sel button .count{font-size:11px;color:#888;margin-top:4px;font-weight:500}
.mode-sel button.done{border-color:#2e7d32;background:#e8f5e9;color:#1b5e20}
.round-bar{background:#fff;border:1px solid #e0e0e0;border-radius:10px;padding:10px 14px;margin-bottom:12px;display:flex;justify-content:space-around;align-items:center;font-size:12px;color:#666}
.round-bar b{display:block;font-size:17px;color:#da251d;font-weight:700;margin-top:2px}
.round-bar .sep{width:1px;height:30px;background:#e0e0e0}
.stage-badge{display:inline-block;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:700;margin-bottom:10px}
.stage-badge.s1{background:#e3f2fd;color:#1565c0}
.stage-badge.s2{background:#fff3e0;color:#ef6c00}

/* === Fill mode === */
.qcard{background:#fff;border:2px solid #e0e0e0;border-radius:16px;padding:20px;margin-bottom:14px;position:relative}
.qcard .qidx{position:absolute;top:12px;right:16px;font-size:12px;color:#aaa;font-weight:600}
.qcard .qlabel{font-size:11px;color:#888;letter-spacing:1px;font-weight:600;margin-bottom:10px;text-align:center}
.qcard .qfill{font-size:20px;font-weight:700;color:#222;line-height:1.7;margin-bottom:10px;text-align:center}
.qcard .qfill .blank{color:#da251d;background:#fff8e6;padding:2px 14px;border-radius:6px;border:1px dashed #da251d;margin:0 2px}
.qcard .qjp{font-size:12px;color:#666;text-align:center;padding:6px 8px;background:#f8f8f8;border-radius:6px;margin-top:6px}
.choices-hint{background:#fff8e6;border:1px solid #ffd666;border-radius:8px;padding:8px 10px;font-size:11px;color:#8b6914;margin-bottom:12px;line-height:1.6}
.unsolved{background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:10px;font-size:12px;color:#856404;margin-bottom:10px;text-align:center}

.ans-input{width:100%;padding:14px;border:2px solid #1976d2;border-radius:12px;font-size:20px;font-family:inherit;background:#fafbff;text-align:center;color:#222;margin-bottom:14px}
.ans-input:focus{outline:none;border-color:#0d47a1;background:#fff;box-shadow:0 0 0 3px rgba(25,118,210,.15)}
.ans-input.excellent{border-color:#1b5e20;background:#c8e6c9;color:#1b5e20}
.ans-input.good{border-color:#43a047;background:#e8f5e9;color:#2e7d32}
.ans-input.okay{border-color:#ef6c00;background:#fff3e0;color:#e65100}
.ans-input.bad{border-color:#c62828;background:#ffebee;color:#b71c1c}

/* === Rearrange mode === */
.rearrange-area{background:#fff;border:2px solid #e0e0e0;border-radius:16px;padding:14px;margin-bottom:14px}
.rearrange-row{display:flex;align-items:center;gap:6px;background:#fafbff;border:1px solid #e0e0e0;border-radius:10px;padding:8px 10px;margin-bottom:6px}
.rearrange-row .pos{font-size:11px;color:#888;font-weight:700;min-width:22px;text-align:center}
.rearrange-row .word{flex:1;font-size:16px;font-weight:600;color:#222;word-break:break-word}
.rearrange-row .arrows{display:flex;gap:4px}
.rearrange-row .arrows button{width:32px;height:32px;border:none;border-radius:6px;background:#1976d2;color:#fff;font-size:14px;cursor:pointer;font-weight:700}
.rearrange-row .arrows button:active{transform:scale(.9)}
.rearrange-row .arrows button:disabled{background:#ccc;cursor:not-allowed}
.rearrange-row.locked{background:#f0f0f0;opacity:.7}
.rearrange-row.locked .arrows{display:none}
.rearrange-preview{background:#e8f5e9;border:1px solid #81c784;border-radius:10px;padding:12px;margin-bottom:12px;font-size:14px;color:#1b5e20;line-height:1.6;text-align:center;min-height:50px;display:flex;align-items:center;justify-content:center}

.judge-box{border-radius:12px;padding:14px;margin-bottom:14px;text-align:center;display:none}
.judge-box.show{display:block}
.judge-box.excellent{background:linear-gradient(135deg,#2e7d32,#43a047);color:#fff}
.judge-box.good{background:linear-gradient(135deg,#66bb6a,#81c784);color:#fff}
.judge-box.okay{background:linear-gradient(135deg,#ffa726,#fb8c00);color:#fff}
.judge-box.bad{background:linear-gradient(135deg,#ef5350,#e53935);color:#fff}
.judge-box.listen{background:linear-gradient(135deg,#5c6bc0,#3949ab);color:#fff}
.judge-box.unsolved{background:linear-gradient(135deg,#ffa726,#ff9800);color:#fff}
.judge-box .icon{font-size:38px;font-weight:800;display:block;margin-bottom:4px;line-height:1}
.judge-box .msg{font-size:13px;margin-bottom:6px;opacity:.95}
.judge-box .correct-ans{background:rgba(255,255,255,.25);border-radius:8px;padding:10px;font-size:16px;font-weight:700;display:inline-block;margin-top:4px;max-width:100%;word-break:break-word;line-height:1.5}
.judge-box .correct-ans small{display:block;font-size:11px;opacity:.85;margin-top:6px;font-weight:400}

.btn-row{display:flex;gap:10px;margin-bottom:10px}
.btn-row button{flex:1;padding:16px 8px;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit}
.btn-row button:active{opacity:.75;transform:scale(.96)}
.btn-check{background:#1976d2;color:#fff}
.btn-speak-big{background:#5c6bc0;color:#fff;font-size:16px!important;padding:20px!important}
.btn-speak-big.speaking{background:#3949ab}
.btn-next{background:#2e7d32;color:#fff}
.btn-skip{background:#f5f5f5;color:#666;border:1px solid #ddd!important}

.voice-info{background:#e3f2fd;border:1px solid #64b5f6;border-radius:8px;padding:8px 12px;font-size:12px;color:#1565c0;margin-bottom:10px}
.voice-info.warn{background:#fff3e0;border-color:#ffb74d;color:#e65100}
.voice-info.err{background:#ffebee;border-color:#e57373;color:#c62828}

.complete{background:linear-gradient(135deg,#4caf50,#8bc34a);color:#fff;border-radius:16px;padding:40px 20px;text-align:center;box-shadow:0 3px 10px rgba(0,0,0,.1)}
.complete h2{font-size:28px;margin-bottom:8px}
.complete p{font-size:14px;opacity:.95;margin-bottom:16px}
.complete button{background:#fff;color:#2e7d32;border:none;padding:12px 24px;border-radius:10px;font-weight:700;font-size:14px;cursor:pointer;font-family:inherit;margin:4px}
.reset-bar{display:flex;gap:8px;margin-top:12px}
.reset-bar button{flex:1;padding:8px;background:none;border:1px solid #ccc;border-radius:8px;color:#888;font-size:11px;cursor:pointer;font-family:inherit}
</style>
</head>
