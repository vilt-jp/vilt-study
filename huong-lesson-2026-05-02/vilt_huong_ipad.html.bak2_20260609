  var rArr = []; // 並び替えモードの現在の並び (語インデックス配列)

  function skey(mode){ return "vilt_huong_2026_05_02_"+mode; }
  function loadSt(mode){ try{ var s = localStorage.getItem(skey(mode)); if(s) return JSON.parse(s); }catch(e){} return null; }
  function saveSt(mode, st){ try{ localStorage.setItem(skey(mode), JSON.stringify(st)); }catch(e){} }
  function dataFor(mode){ return mode === "fill" ? FILL_QUESTIONS : REARRANGE_QUESTIONS; }
  function initSt(mode){
    var d = dataFor(mode);
    return { round:1, queue:d.map(function(_,i){return i;}), nextQueue:[], done:[], idx:0, stage:1, finished:false, total:d.length };
  }

  // ===== Voice =====
  var viVoice = null;
  function loadVoices(){
    var v = window.speechSynthesis.getVoices();
    viVoice = v.find(function(x){ return x.lang && x.lang.toLowerCase().indexOf("vi") === 0; });
    var el = document.getElementById("voiceInfo");
    if(!("speechSynthesis" in window)){ el.className="voice-info err"; el.textContent="❌ 音声未対応"; return; }
    if(viVoice){ el.className="voice-info"; el.innerHTML="✅ 音声: <b>"+viVoice.name+"</b>"; }
    else{ el.className="voice-info warn"; el.innerHTML="⚠️ ベトナム語音声なし"; }
  }
  function speak(text, btn){
    if(!("speechSynthesis" in window)) return;
    window.speechSynthesis.cancel();
    var msg = new SpeechSynthesisUtterance(text);
    msg.lang="vi-VN"; msg.rate=0.85;
    if(viVoice) msg.voice = viVoice;
    if(btn) btn.classList.add("speaking");
    msg.onend = function(){ if(btn) btn.classList.remove("speaking"); };
    msg.onerror = function(){ if(btn) btn.classList.remove("speaking"); };
    window.speechSynthesis.speak(msg);
  }

  // ===== String compare =====
  function stripDiacritics(s){ return s.normalize("NFD").replace(/[̀-ͯ]/g,"").replace(/đ/g,"d").replace(/Đ/g,"D"); }
  function normalize(s){ return s.trim().toLowerCase().replace(/\s+/g," ").replace(/[.,!?;:]/g,""); }
  function compareAns(input, correct){
    var i = normalize(input), a = normalize(correct);
    if(i === "") return "empty";
    if(i === a) return "perfect";
    if(stripDiacritics(i) === stripDiacritics(a)) return "tone_only";
    return "wrong";
  }

  // ===== Mode menu =====
  function renderModeMenu(){
    var menu = document.getElementById("modeMenu");
    menu.innerHTML = "";
    var modes = [
      {id:"fill", icon:"📝", title:"問題I 穴埋め", count:FILL_QUESTIONS.length},
      {id:"rearrange", icon:"🔀", title:"問題II 並び替え", count:REARRANGE_QUESTIONS.length}
    ];
    modes.forEach(function(m){
      var btn = document.createElement("button");
      var st = loadSt(m.id);
      var doneCount = st ? st.done.length : 0;
      var isDone = st && st.finished && doneCount === m.count;
      btn.className = isDone ? "done" : "";
      btn.innerHTML = "<div class='ic'>"+m.icon+"</div><div>"+m.title+"</div><div class='count'>◎ "+doneCount+" / "+m.count+" 問"+(isDone?" ✓":"")+"</div>";
      btn.addEventListener("click", function(){ start(m.id); });
      menu.appendChild(btn);
    });
  }

  function start(mode){
    currentMode = mode;
    state = loadSt(mode) || initSt(mode);
    if(state.finished){ state = initSt(mode); saveSt(mode, state); }
    document.getElementById("modeArea").classList.add("hidden");
    document.getElementById("learnArea").classList.remove("hidden");
    document.getElementById("completeArea").classList.add("hidden");
    if(mode === "fill"){
      document.getElementById("fillSection").classList.remove("hidden");
      document.getElementById("rearrangeSection").classList.add("hidden");
      document.getElementById("choicesHint").innerHTML = "<b>選択肢一覧</b>: " + FILL_CHOICES;
    }else{
      document.getElementById("fillSection").classList.add("hidden");
      document.getElementById("rearrangeSection").classList.remove("hidden");
    }
    render();
  }
  function back(){
    currentMode = null; state = null;
    document.getElementById("modeArea").classList.remove("hidden");
    document.getElementById("learnArea").classList.add("hidden");
    document.getElementById("completeArea").classList.add("hidden");
    renderModeMenu();
  }

  function curQ(){
    if(!state || state.queue.length === 0) return null;
    return dataFor(currentMode)[state.queue[state.idx]];
  }
  function setStage(st){
    var b = document.getElementById("stageBadge");
    if(st === 1){ b.className="stage-badge s1"; b.textContent="STEP 1: 音声なしで挑戦"; }
    else { b.className="stage-badge s2"; b.textContent="STEP 2: 音声を聞いてから入力"; }
  }

  // ===== Fill mode rendering =====
  function renderFill(q){
    document.getElementById("qFill").innerHTML = q.sentence.replace(/_{2,}|\(___\)/g, '<span class="blank">___</span>');
    document.getElementById("qFillJp").textContent = q.jp;
    document.getElementById("fIdx").textContent = (state.idx+1)+"/"+state.queue.length;
    var unsolved = document.getElementById("unsolvedFill");
    if(q.confirmed){ unsolved.classList.add("hidden"); }
    else { unsolved.classList.remove("hidden"); }
    var i = document.getElementById("fillAns");
    i.value = ""; i.className = "ans-input"; i.disabled = false;
    setTimeout(function(){ try{ i.focus(); }catch(e){} }, 50);
  }

  // ===== Rearrange mode rendering =====
  function renderRearrange(q){
    document.getElementById("rIdx").textContent = (state.idx+1)+"/"+state.queue.length;
    document.getElementById("qRearrangeJp").textContent = q.ans ? "正解例あり (添削済み)" : "⚠️ 正解未確定 - 並べたら自分で確認";
    // Shuffle words for initial display
    rArr = q.words.map(function(_,i){return i;});
    for(var i=rArr.length-1;i>0;i--){
      var j = Math.floor(Math.random()*(i+1));
      var t = rArr[i]; rArr[i] = rArr[j]; rArr[j] = t;
    }
    drawRearrange(q);
    var unsolved = document.getElementById("unsolvedRearrange");
    if(q.ans){ unsolved.classList.add("hidden"); }
    else { unsolved.classList.remove("hidden"); }
  }

  function drawRearrange(q){
    var area = document.getElementById("rearrangeArea");
    area.innerHTML = "";
    rArr.forEach(function(wIdx, pos){
      var row = document.createElement("div");
      row.className = "rearrange-row";
      var posLabel = document.createElement("div"); posLabel.className = "pos"; posLabel.textContent = (pos+1);
      var word = document.createElement("div"); word.className = "word"; word.textContent = q.words[wIdx];
      var arrows = document.createElement("div"); arrows.className = "arrows";
      var up = document.createElement("button"); up.textContent = "↑"; up.disabled = (pos === 0);
      up.addEventListener("click", function(){ moveItem(pos, -1); });
      var down = document.createElement("button"); down.textContent = "↓"; down.disabled = (pos === rArr.length-1);
      down.addEventListener("click", function(){ moveItem(pos, 1); });
      arrows.appendChild(up); arrows.appendChild(down);
      row.appendChild(posLabel); row.appendChild(word); row.appendChild(arrows);
      area.appendChild(row);
    });
    // Update preview
    var preview = document.getElementById("rearrangePreview");
    var sentence = rArr.map(function(wIdx){ return q.words[wIdx]; }).join(" ");
    preview.textContent = sentence;
  }

  function moveItem(pos, dir){
    var newPos = pos + dir;
    if(newPos < 0 || newPos >= rArr.length) return;
    var t = rArr[pos]; rArr[pos] = rArr[newPos]; rArr[newPos] = t;
    var q = curQ(); if(q) drawRearrange(q);
  }

  function render(){
    if(state.finished){ showComplete(); return; }
    var q = curQ(); if(!q) return;
    document.getElementById("s-round").textContent = state.round+" / "+MAX_ROUND;
    document.getElementById("s-remain").textContent = state.queue.length;
    document.getElementById("s-done").textContent = state.done.length+" / "+state.total;
    document.getElementById("bar").style.width = Math.round((state.done.length/state.total)*100)+"%";

    if(currentMode === "fill") renderFill(q);
    else renderRearrange(q);

    document.getElementById("judge").classList.remove("show");
    document.getElementById("btnsStage1").classList.remove("hidden");
    document.getElementById("btnsListen").classList.add("hidden");
    document.getElementById("btnsStage2").classList.add("hidden");
    document.getElementById("btnsNext").classList.add("hidden");
    state.stage = 1; setStage(1); rank = null;
  }

  function showComplete(){
    document.getElementById("learnArea").classList.add("hidden");
    document.getElementById("completeArea").classList.remove("hidden");
    var label = currentMode === "fill" ? "穴埋め" : "並び替え";
    document.getElementById("completeMsg").textContent =
      state.done.length === state.total
        ? label+" 全"+state.total+"問 ◎ で完了！"
        : MAX_ROUND+"周終了。◎ "+state.done.length+"/"+state.total+"問";
  }

  // ===== Judgment =====
  function applyJudgment(r, q, val){
    var jb = document.getElementById("judge");
    rank = r;
    var cls = "";
    if(r === "◎"){ cls="excellent"; document.getElementById("judgeIcon").textContent="◎"; document.getElementById("judgeMsg").textContent="完全正解！合格"; }
    else if(r === "〇"){ cls="good"; document.getElementById("judgeIcon").textContent="〇"; document.getElementById("judgeMsg").textContent="声調記号のみミス → 次周"; }
    else if(r === "△"){ cls="okay"; document.getElementById("judgeIcon").textContent="△"; document.getElementById("judgeMsg").textContent="音声を聞いて書けました → 次周"; }
    else if(r === "?"){ cls="unsolved"; document.getElementById("judgeIcon").textContent="?"; document.getElementById("judgeMsg").textContent="正解未確定。Huong先生に確認推奨"; }
    else { cls="bad"; document.getElementById("judgeIcon").textContent="×"; document.getElementById("judgeMsg").textContent="不正解 → 次周"; }
    jb.className = "judge-box show " + cls;

    var input = document.getElementById("fillAns");
    if(currentMode === "fill"){
      if(r === "◎") input.className="ans-input excellent";
      else if(r === "〇") input.className="ans-input good";
      else if(r === "△") input.className="ans-input okay";
      else input.className="ans-input bad";
      input.disabled = true;
      if(q.confirmed && q.ans){
        var filled = q.sentence.replace(/_{2,}|\(___\)/g, '<b style="color:#fff;text-decoration:underline">'+q.ans+'</b>');
        document.getElementById("correctAns").innerHTML = filled + "<small>正解: "+q.ans+" | "+q.jp+"</small>";
      }else{
        document.getElementById("correctAns").innerHTML = "<b>正解未確定</b><small>Huong先生に確認してください<br>あなたの答え: "+(val||"(未入力)")+"</small>";
      }
    }else{
      // rearrange mode
      var userSentence = rArr.map(function(wi){ return q.words[wi]; }).join(" ");
      if(q.ans){
        document.getElementById("correctAns").innerHTML = q.ans + "<small>あなた: "+userSentence+"</small>";
      }else{
        document.getElementById("correctAns").innerHTML = "<b>正解未確定</b><small>あなたの並び: "+userSentence+"</small>";
      }
    }

    document.getElementById("btnsStage1").classList.add("hidden");
    document.getElementById("btnsListen").classList.add("hidden");
    document.getElementById("btnsStage2").classList.add("hidden");
    document.getElementById("btnsNext").classList.remove("hidden");
  }

  function doCheckFill1(){
    var q = curQ(); if(!q) return;
    if(!q.confirmed){
      // 正解未確定 → スキップ的扱い、次周に残す
      applyJudgment("?", q, document.getElementById("fillAns").value);
      return;
    }
    var v = document.getElementById("fillAns").value;
    var r = compareAns(v, q.ans);
    if(r === "empty"){ document.getElementById("fillAns").focus(); return; }
    if(r === "perfect") applyJudgment("◎", q, v);
    else if(r === "tone_only") applyJudgment("〇", q, v);
    else showListenFill(v);
  }
  function doCheckFill2(){
    var q = curQ(); if(!q) return;
    var v = document.getElementById("fillAns").value;
    var r = compareAns(v, q.ans);
    if(r === "empty"){ document.getElementById("fillAns").focus(); return; }
    if(r === "perfect" || r === "tone_only") applyJudgment("△", q, v);
    else applyJudgment("×", q, v);
  }
  function showListenFill(prev){
    var i = document.getElementById("fillAns");
    i.className="ans-input bad"; i.disabled=true;
    var jb = document.getElementById("judge");
    jb.className="judge-box show listen";
    document.getElementById("judgeIcon").textContent="🔊";
    document.getElementById("judgeMsg").textContent="不正解。音声を聞いてもう一度";
    document.getElementById("correctAns").innerHTML = "あなた: " + (prev || "(未入力)");
    document.getElementById("btnsStage1").classList.add("hidden");
    document.getElementById("btnsListen").classList.remove("hidden");
  }
  function doSpeakAndAdvanceFill(){
    var q = curQ(); if(!q || !q.ans) return;
    var full = q.sentence.replace(/_{2,}|\(___\)/g, q.ans);
    speak(full, document.getElementById("btnSpeakBig"));
    setTimeout(function(){
      state.stage = 2; setStage(2);
      var i = document.getElementById("fillAns");
      i.value=""; i.className="ans-input"; i.disabled=false;
      document.getElementById("judge").classList.remove("show");
      document.getElementById("btnsListen").classList.add("hidden");
      document.getElementById("btnsStage2").classList.remove("hidden");
      try{ i.focus(); }catch(e){}
    }, 500);
  }

  function doCheckRearrange(){
    var q = curQ(); if(!q) return;
    var userSentence = rArr.map(function(wi){ return q.words[wi]; }).join(" ");
    if(!q.ans){
      applyJudgment("?", q, userSentence);
      return;
    }
    var r = compareAns(userSentence, q.ans);
    if(r === "perfect") applyJudgment("◎", q, userSentence);
    else if(r === "tone_only") applyJudgment("〇", q, userSentence);
    else applyJudgment("×", q, userSentence);
  }

  function doSkip(){
    var q = curQ(); if(!q) return;
    applyJudgment("×", q, "");
  }

  function doNext(){
    var qi = state.queue[state.idx];
    if(rank === "◎"){ if(state.done.indexOf(qi) < 0) state.done.push(qi); }
    else{ if(state.nextQueue.indexOf(qi) < 0) state.nextQueue.push(qi); }
    state.queue.splice(state.idx, 1);
    if(state.idx >= state.queue.length){
      if(state.nextQueue.length === 0 || state.round >= MAX_ROUND) state.finished = true;
      else{ state.round++; state.queue = state.nextQueue; state.nextQueue = []; state.idx = 0; }
    }
    saveSt(currentMode, state);
    render();
  }

  // ===== Events =====
  document.getElementById("btnCheck").addEventListener("click", function(){
    if(currentMode === "fill") doCheckFill1();
    else doCheckRearrange();
  });
  document.getElementById("btnCheck2").addEventListener("click", function(){
    if(currentMode === "fill") doCheckFill2();
  });
  document.getElementById("btnSpeakBig").addEventListener("click", function(){
    if(currentMode === "fill") doSpeakAndAdvanceFill();
  });
  document.getElementById("btnSkip").addEventListener("click", doSkip);
  document.getElementById("btnNext").addEventListener("click", doNext);
  document.getElementById("fillAns").addEventListener("keydown", function(e){
    if(e.key === "Enter"){ e.preventDefault(); if(state && state.stage === 1) doCheckFill1(); else doCheckFill2(); }
  });
  document.getElementById("btnBack").addEventListener("click", back);
  document.getElementById("btnResetCur").addEventListener("click", function(){
    if(confirm("このモードをリセット?")){ state = initSt(currentMode); saveSt(currentMode, state); render(); }
  });
  document.getElementById("btnResetAll").addEventListener("click", function(){
    if(confirm("全進捗リセット?")){ ["fill","rearrange"].forEach(function(m){ localStorage.removeItem(skey(m)); }); renderModeMenu(); }
  });

  if("speechSynthesis" in window){
    loadVoices();
    if(window.speechSynthesis.onvoiceschanged !== undefined){
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }
  }
  renderModeMenu();
})();
</script>

<script>
function huongShowExplain(){
  ["modeArea","learnArea","completeArea"].forEach(function(id){var e=document.getElementById(id);if(e)e.classList.add("hidden");});
  var x=document.getElementById("explainArea"); if(x) x.classList.remove("hidden");
  window.scrollTo(0,0);
}
function huongExplainBack(){
  var x=document.getElementById("explainArea"); if(x) x.classList.add("hidden");
  var m=document.getElementById("modeArea"); if(m) m.classList.remove("hidden");
  window.scrollTo(0,0);
}
</script>
</body>
